.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.env
.DS_Store

# Reproducible generated data; keep only small samples in version control.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Local spreadsheet output can be regenerated by the pipeline.
reports/*.xlsx

# Large deterministic outputs are regenerated locally; aggregate evidence and
# dashboard previews remain versioned for lightweight GitHub clones.
artifacts/pricing/policy_pricing_scores.csv
artifacts/fraud/claim_triage_scores.csv
powerbi/data/pricing_scores.csv
powerbi/data/claim_triage.csv
